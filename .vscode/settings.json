{
	"search.exclude": {
		".vscode": false,
		".editorconfig": false,
		"biome.json": false,
		"tsconfig.*": false,
		"package.json": false,
		"package-lock.json": false,
		"*.config.ts": false,
		"dist": false,
		"coverage": false,
		".copilot": false,
		".github": false,
		"LICENSE": false,
		".*": false,
		"node_modules": false
	},
	"editor.formatOnSave": true,
	"[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
	"[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
	"[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
	"[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
	"[json]": { "editor.defaultFormatter": "biomejs.biome" },
	"[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
	"[markdown]": { "editor.defaultFormatter": "biomejs.biome" },
	"markdown.format.codeBlocks": true,
	"files.exclude": {
		".vscode": true,
		".editorconfig": true,
		"biome.json": true,
		"tsconfig.*": true,
		"package.json": true,
		"package-lock.json": true,
		"*.config.ts": true,
		"dist": true,
		"coverage": true,
		".copilot": true,
		".github": true,
		"LICENSE": true,
		".*": true,
		"node_modules": true
	},
	"cSpell.words": ["cloudly"],
	"ts.tsdk": "node_modules/typescript/lib"
}
