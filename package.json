{
	"name": "cloudly-router",
	"version": "1.0.0",
	"description": "Router for web worker based backends such as CloudFlare Workers.",
	"author": "Simon Mika <simon@mika.se>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/utily/cloudly-router"
	},
	"bugs": {
		"url": "https://github.com/utily/cloudly-router/issues"
	},
	"homepage": "https://github.com/utily/cloudly-router",
	"private": false,
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"lint": "biome format .",
		"format": "biome format --write .",
		"build": "rimraf dist/* && tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"prepare": "npm run build",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/github": "12.0.11",
		"@semantic-release/npm": "13.2.0",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@vitest/coverage-v8": "5.1.2",
		"conventional-changelog-conventionalcommits": "10.4.1",
		"rimraf": "6.1.4",
		"semantic-release": "26.0.1",
		"typescript": "7.0.2",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	},
	"dependencies": {
		"cloudly-http": "^1.2.0",
		"gracely": "^2.1.0",
		"isly": "1.4.0",
		"typedly": "^1.1.0",
		"urlpattern-polyfill": "^10.1.0"
	}
}
